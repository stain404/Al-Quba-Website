# Contact form / newsletter email delivery.
# Copy this file to .env.local (for local dev) and add the same
# variables in Vercel: Project Settings -> Environment Variables
# (for production). .env.local is gitignored -- never commit real
# credentials.
#
# Setup for a Google Workspace / Gmail account (inbox@alqubainvestment.com):
#   1. Turn on 2-Step Verification for that account, if not already on:
#      https://myaccount.google.com/security
#   2. Generate an App Password (NOT the normal login password):
#      https://myaccount.google.com/apppasswords
#      -> choose "Mail" as the app, copy the 16-character password.
#   3. Fill in the values below.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=inbox@alqubainvestment.com
SMTP_PASS=paste-the-16-character-app-password-here

# Where submissions get delivered. Defaults to SMTP_USER if omitted.
CONTACT_TO_EMAIL=inbox@alqubainvestment.com

# ---------------------------------------------------------------------------
# Newsletter subscriber list (Brevo)
# ---------------------------------------------------------------------------
# The contact form uses SMTP above; newsletter signups instead go into a
# Brevo contact list so subscribers actually accumulate somewhere you can
# view and export, rather than arriving as loose emails.
#
#   1. Create a free account at https://www.brevo.com (no card required).
#   2. Contacts -> Lists -> create a list, e.g. "Website newsletter".
#      Its numeric ID shows in the list URL and the lists table.
#   3. Top-right menu -> SMTP & API -> API Keys -> Generate a new API key.
#
# The API key grants access to the Brevo account -- treat it like a
# password and set it only on the server, never in the repo.
BREVO_API_KEY=
BREVO_LIST_ID=

# ---------------------------------------------------------------------------
# Analytics (Google Tag Manager)
# ---------------------------------------------------------------------------
# Container ID from https://tagmanager.google.com -> Workspace -> top bar.
# Format: GTM-XXXXXXX
#
# Leave this UNSET locally and on preview deployments -- the GTM snippet
# renders nothing without it, so dev traffic never reaches production
# analytics. Set it only on the Production environment in Vercel.
#
# Conversion events pushed to the dataLayer (see src/lib/analytics.ts):
#   generate_lead         -- contact form submitted successfully
#   newsletter_signup     -- newsletter subscribed (footer or insights)
#   whatsapp_click        -- floating WhatsApp button opened
#   investor_login_click  -- investor dashboard login opened
#
# In GTM, create a Custom Event trigger for each of these names, then a
# GA4 Event tag firing on it. Mark generate_lead as a key event/conversion
# in GA4 -> Admin -> Events.
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# Meta Pixel (Facebook / Instagram ads)
# ---------------------------------------------------------------------------
# Pixel ID from https://business.facebook.com -> Events Manager -> Data
# Sources. It is a numeric string, e.g. 1234567890123456 (NOT the
# "dataset" or ad account ID).
#
# Same rule as GTM above: leave this UNSET locally and on previews. The
# snippet renders nothing without it, so dev traffic never pollutes the
# pixel's audiences or skews ad optimisation.
#
# Events sent (see src/lib/analytics.ts -- one map, no scattered fbq calls):
#   PageView       -- every page, including client-side navigation
#   Lead           -- contact form submitted successfully
#   Subscribe      -- newsletter subscribed
#   Contact        -- floating WhatsApp button opened
#   InvestorLogin  -- investor dashboard opened (custom, not a standard event)
#
# NOTE: adding this makes the site share visitor data with Meta for
# advertising. Section 6 of the privacy policy was updated to say so.
# If you later target EU/UK visitors, this needs a consent banner and
# must stay off until the visitor opts in -- it currently loads for
# everyone, which is the normal position for a UAE-facing site but is
# not GDPR-sufficient on its own.
NEXT_PUBLIC_META_PIXEL_ID=
