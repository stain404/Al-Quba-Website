# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# Local tooling config. Kept on disk but out of the repo — it configures
# the editor/assistant tooling, not the site, so it is noise for anyone
# cloning this to build or deploy it.
.claude/
.impeccable/


# Everything in public/ is served at the site root by Next.js, so a
# stray .env there is a publicly downloadable secret. Never ship one.
public/*.env
